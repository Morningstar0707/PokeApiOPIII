{
  "name": "pokemon-api",
  "version": "1.0.0",
  "description": "API REST base para proyecto de aula con Pokémon, PostgreSQL, Prisma y PokeAPI",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "lint": "eslint . --ext .ts",
    "seed": "ts-node prisma/seed.ts",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:generate": "prisma generate"
  },
  "keywords": [
    "pokemon",
    "api",
    "rest",
    "prisma",
    "postgresql",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "prisma": "^5.22.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.8.0",
    "@types/supertest": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
